{
  "_description": "环境锁定配置 - 确保 AI 在任何机器上获得一致的开发环境",
  "_version": "1.0.0",
  "_generated_at": "2026-06-18T16:00:00+08:00",

  "python": {
    "required_version": ">=3.10",
    "recommended_version": "3.11",
    "venv_path": ".venv",
    "activate_command": "source .venv/bin/activate"
  },

  "dependencies": {
    "lock_file": "requirements.lock",
    "pip_mirror": "https://pypi.tuna.tsinghua.edu.cn/simple",
    "install_command": "pip install -r requirements.txt -i https://pypi.tuna.tsinghua.edu.cn/simple"
  },

  "project": {
    "name": "xiaozhi-server",
    "entry_point": "app.py",
    "working_directory": "main/xiaozhi-server",
    "required_dirs": [
      "data",
      "tmp",
      "models",
      ".harness/logs"
    ]
  },

  "external_services": {
    "llm_api": {
      "default": "deepseek",
      "endpoints": {
        "deepseek": "https://api.deepseek.com",
        "glm": "https://open.bigmodel.cn/api/paas/v4/",
        "ali": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "doubao": "https://ark.cn-beijing.volces.com/api/v3"
      },
      "timeout": 60
    },
    "project_apis": {
      "sanyuanli_workerstatus": "https://dmap.cscec3bxjy.cn/api/dibang/report/workerstatus",
      "sanyuanli_personnel": "https://smarthat.lanjiansuzhou.com/dashboard/proj/safety/present_worker/list",
      "timeout": 30
    },
    "tts": {
      "default": "edge",
      "timeout": 10
    }
  },

  "config_files": {
    "template": "config.yaml",
    "overrides": "data/.config.yaml",
    "api_override": "config_from_api.yaml"
  },

  "database": {
    "type": "none_local",
    "note": "当前不使用本地数据库，数据来自远程 API 调用"
  },

  "network": {
    "allow_outbound": true,
    "required_ports": [8000, 8003],
    "proxy": null
  },

  "runtime_vars": {
    "HARNESS_MODE": "off",
    "PYTHONPATH": "main/xiaozhi-server",
    "LOG_LEVEL": "INFO"
  }
}